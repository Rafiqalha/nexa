      "required": true,
      "code": "(async () => { const j = (u) => fetch(u, { headers: { accept: 'application/json' } }).then((r) => r.json()); const { sessions } = await j('/api/sessions?limit=20&flagged=1'); const fresh = sessions.filter((s) => s.classification === 'agent' && s.firstSeenAt > Date.now() - 30 * 60 * 1000).sort((a, b) => b.firstSeenAt - a.firstSeenAt); if (!fresh.length) return false; window.__sid = fresh[0].id; const d = await j('/api/sessions/' + window.__sid); return Boolean(d.intel && d.intel.status === 'done' && d.rules.some((r) => r.status === 'draft' && r.syntaxValid === true)); })()"
    },
