{
  "name": "nexa",
  "version": "0.1.0",
  "private": true,
  "description": "NEXA — lapisan deception defensif untuk agen AI otonom (Kartika Cyber Hackathon 2026)",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "env:init": "node scripts/ensure-env.mjs",
    "token": "node scripts/copy-token.mjs",
    "dev": "node scripts/ensure-env.mjs && pnpm --parallel --filter sensor --filter dashboard dev",
    "build": "pnpm --filter \"./apps/**\" --filter \"./packages/**\" -r build",
    "desktop": "pnpm --filter desktop start",
    "desktop:installer": "pnpm --filter desktop dist",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "db:generate": "pnpm --filter sensor db:generate",
    "db:migrate": "node scripts/ensure-env.mjs && pnpm --filter sensor db:migrate",
    "lab:up": "node scripts/ensure-env.mjs && node scripts/lab.mjs up",
    "lab:down": "node scripts/lab.mjs down",
    "lab:logs": "docker compose -f deploy/docker-compose.yml logs -f",
    "lab:local": "node scripts/ensure-env.mjs && pnpm --parallel --filter target-app --filter sensor dev",
    "lab:status": "node scripts/lab.mjs status",
    "lab:attack": "node scripts/lab.mjs attack"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
