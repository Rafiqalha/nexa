{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Shell desktop Pos Komando NEXA (Electron). Hanya memuat dashboard dari port admin sensor; tanpa akses DB, tanpa secret.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke-test",
    "typecheck": "tsc -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.7"
  },
  "author": "Tim NEXA"
}
