# Salin ke .env (atau jalankan `pnpm env:init` untuk membuatnya otomatis).
# Nilai di bawah untuk menjalankan di host (pnpm lab:local / pnpm dev).
# docker compose menimpa nilai yang khusus jaringan Docker (UPSTREAM_URL, host, path DB).

# --- Sensor ---
SENSOR_PORT=8080
# Di Docker: http://target-app:3000
UPSTREAM_URL=http://localhost:3000
DATABASE_PATH=./data/nexa.db
# Auth API dashboard, minimal 16 karakter.
DASHBOARD_TOKEN=

# --- Port admin (REST + SSE + MCP intel), tidak pernah dibuka di port jebakan ---
ADMIN_PORT=8081
ADMIN_HOST=127.0.0.1

# --- Model (model-agnostic; ganti baseURL untuk on-premise, mis. Ollama http://localhost:11434/v1) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=
DEEPSEEK_API_KEY=
LLM_DAILY_TOKEN_BUDGET=200000

# --- Deteksi ---
SUSPECT_SCORE_THRESHOLD=0.6
AGENT_SCORE_THRESHOLD=0.85
TIMING_FAST_MS=2500
HONEYLINK_PATHS=/arsip-internal/
SESSION_IDLE_TIMEOUT_MS=60000

# --- Labirin & meteran biaya (estimasi) ---
CHARS_PER_TOKEN=4
BANDIT_EPSILON=0.1
BANDIT_MAX_HOLD_MS=120000

# --- Rules ---
SURICATA_RULES_DIR=./deploy/suricata/rules
SURICATA_CONTAINER=suricata
# Cara sensor menjalankan suricata -T & reload: none | exec | control
#  - control: sidecar di container Suricata (docker compose mengisi otomatis)
#  - exec   : wrapper lokal, mis. via WSL (lihat deploy/suricata/setup-wsl.sh):
#             SURICATA_EXEC=wsl.exe -d kali-linux -- bash /home/<user>/nexa-suricata/nexa-suricata.sh
#  - none   : draf rule tetap dibuat tapi "belum divalidasi" dan tidak bisa di-deploy
SURICATA_RUNNER=none
SURICATA_EXEC=
SURICATA_CONTROL_URL=
# Token sidecar kontrol Suricata (dibuat otomatis oleh pnpm env:init), min 16 karakter.
SURICATA_CONTROL_TOKEN=

# --- Lab (hanya dev). Entri host atau host:port; host/port lain ditolak agen uji ---
LAB_TARGET_ALLOWLIST=localhost:8080,localhost:3000

# --- Agen penyerang lab (hanya dev; tidak ikut build produksi) ---
# Key model agen DIPISAH dari key sensor (AGENTS.md §2.6): kode agen tidak pernah membaca
# DEEPSEEK_API_KEY. Boleh diisi key DeepSeek yang sama atau key lain. Kosong = mode scripted.
ATTACKER_LLM_BASE_URL=https://api.deepseek.com
ATTACKER_LLM_MODEL=deepseek-flash
ATTACKER_LLM_API_KEY=
ATTACKER_TARGET_URL=http://localhost:8080/
ATTACKER_BASELINE_URL=http://localhost:3000/
ATTACKER_MAX_STEPS=15
ATTACKER_MAX_TOKENS=250000
ATTACKER_STEP_DELAY_MS=1500
